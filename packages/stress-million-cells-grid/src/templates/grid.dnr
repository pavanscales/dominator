<div class="grid-container"
     onscroll="onScroll"
     style="contain: strict; content-visibility: auto; background: #000; color: #eee; overflow: auto; width: 100%; height: 100%; position: relative; font-family: ui-monospace, monospace; scrollbar-width: thin; scrollbar-color: #333 #000;">

  <div class="grid-spacer"
       style="position: relative; height: 24000px; width: 80000px;">

    <div class="grid-viewport"
         style:transform="{state.getViewportTransform()}"
         style="position: absolute; top: 0; left: 0; display: flex; flex-direction: column; will-change: transform;">

      {#each state.visibleRows() as row}
        <div class="grid-row">
          {#each state.visibleCols() as col}
            <div class="{state.getCellFullClass(row, col)}"
                 style:background="{state.getCellBg(row, col)}"
                 onclick="{() => window.onCellClick(row, col)}">
              {state.getCellValue(row, col)}
            </div>
          {/each}
        </div>
      {/each}

    </div>
  </div>

  <div class="perf-overlay" style="position: fixed; bottom: 12px; right: 12px; background: rgba(0,0,0,0.9); color: #888; padding: 16px; font-size: 10px; border: 1px solid #222; z-index: 1000; backdrop-filter: blur(8px); pointer-events: none; line-height: 1.8; box-shadow: 0 4px 20px rgba(0,0,0,0.5);">
    <div style="color: #fff; margin-bottom: 8px; border-bottom: 1px solid #333; padding-bottom: 6px; letter-spacing: 0.2em; font-weight: bold;">DOMINATOR STRESS 1M</div>
    <div style="display: flex; justify-content: space-between; gap: 20px;">
      <span>FPS</span>
      <span style:color="{state.perf.fps() < 55 ? '#ff4444' : '#00ff00'}" style="font-weight: bold;">{state.perf.fps()}</span>
    </div>
    <div style="display: flex; justify-content: space-between;">
      <span>RENDER</span>
      <span style="color: #eee;">{state.perf.avgRenderTime()}ms</span>
    </div>
    <div style="display: flex; justify-content: space-between;">
      <span>BATCH</span>
      <span style="color: #eee;">{state.perf.lastUpdateBatchSize()}</span>
    </div>
    <div style="margin-top: 8px; border-top: 1px solid #333; padding-top: 8px; color: #aaa;">
      <div style="display: flex; justify-content: space-between;">
        <span>AVG VAL</span>
        <span>{state.stats().avg}</span>
      </div>
      <div style="display: flex; justify-content: space-between;">
        <span>HIGH</span>
        <span style="color: #fff;">{state.stats().highValues}</span>
      </div>
    </div>
  </div>
</div>
